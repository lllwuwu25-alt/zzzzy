# Deployment-only configuration. Never put these secrets in VITE_* variables.
APP_ENV=staging
APP_DOMAIN=notebook.example.com
ACME_EMAIL=operator@example.com
PUBLIC_APP_URL=https://notebook.example.com
API_PUBLIC_URL=https://notebook.example.com
ALLOWED_ORIGINS=https://notebook.example.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
DATABASE_URL=file:/data/sync.db
HOST=0.0.0.0
PORT=8787
FEISHU_APP_TYPE=self_built
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://notebook.example.com/v1/auth/feishu/callback
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_SCOPES=offline_access bitable:app
# Generate TWO different random 32-byte base64 values. Keep separate from DB backups.
TOKEN_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=
BINDING_TTL_SECONDS=300
# Client build value is public, never a secret. Docker derives it from APP_DOMAIN.
VITE_SYNC_GATEWAY_URL=https://notebook.example.com
