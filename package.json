{
  "name": "mistake-notebook",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run && npm run test:license",
    "test:license": "node --test tools/license-admin/*.test.mjs tools/license-desktop/*.test.mjs scripts/local-package.test.mjs",
    "license:admin": "node tools/license-admin/cli.mjs",
    "license:desktop": "npm --prefix tools/license-desktop start",
    "license:desktop:build": "node scripts/build-license-desktop.mjs",
    "desktop:local-test": "node scripts/build-local-test.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "2.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
